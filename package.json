{
  "name": "choirbot",
  "version": "2.0.0",
  "description": "",
  "main": "app.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "deploy": "gcloud app deploy --quiet app.yaml cron.yaml",
    "gcp-build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch -p tsconfig.build.json",
    "start": "NODE_ENV=prod node --import=extensionless/register dist/app.js",
    "dev": "nodemon --import=extensionless/register -r dotenv/config dist/app.js",
    "test": "jest"
  },
  "type": "module",
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/firestore": "8.5.0",
    "@slack/web-api": "6.12.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5",
    "extensionless": "2.0.6",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "tsscmp": "1.0.6",
    "typescript": "^6"
  },
  "devDependencies": {
    "@babel/preset-env": "7.24.5",
    "@babel/preset-typescript": "7.24.1",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node-fetch": "2.6.9",
    "@types/tsscmp": "1.0.2",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "eslint": "8.57.0",
    "eslint-plugin-jest": "28.5.0",
    "firestore-jest-mock": "0.25.0",
    "jest": "29.7.0",
    "jest-mock-random": "1.1.1",
    "nock": "14.0.0-beta.6",
    "nodemon": "3.0.2"
  },
  "resolutions": {
    "@types/serve-static": "^1.13.10"
  },
  "prettier": {
    "tabWidth": 2,
    "trailingComma": "none",
    "semi": false,
    "singleQuote": true
  },
  "jest": {
    "silent": false,
    "collectCoverage": false,
    "modulePathIgnorePatterns": [
      "<rootDir>/dist"
    ]
  }
}
